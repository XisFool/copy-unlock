{
  "manifest_version": 3,
  "name": "复制解锁增强版",
  "version": "1.0.3",
  "description": "在指定网站恢复文本选择、复制和粘贴，支持实验页拖选自动复制与格子运行状态面板。",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "复制解锁增强版",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
